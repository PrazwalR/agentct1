# ─── LLM (policy compiler + intent reconciler) ───────────────────────────────
# Pick ONE: Anthropic (cloud, needs a key) or Ollama (local, zero key — see below).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Ollama (local LLM, zero API key — alternative to Anthropic) ──────────────
# Run `ollama serve` + `ollama pull llama3.2`, then either set these or pass
# { provider: "ollama" } / --provider ollama explicitly. If ANTHROPIC_API_KEY is
# also set, Anthropic wins unless a provider is set explicitly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ─── Coinbase CDP server wallet (CDP SDK v2) ──────────────────────────────────
CDP_API_KEY_ID=...
CDP_API_KEY_SECRET=...
CDP_WALLET_SECRET=...
# Name of the CDP-managed EVM account agentctl should use
CDP_ACCOUNT_NAME=agentctl-agent

# ─── Circle developer-controlled wallet (optional adapter) ────────────────────
CIRCLE_API_KEY=...
CIRCLE_ENTITY_SECRET=...

# ─── Privy server wallet (optional adapter) ───────────────────────────────────
PRIVY_APP_ID=...
PRIVY_APP_SECRET=...

# ─── x402 ─────────────────────────────────────────────────────────────────────
# NOTE: the facilitator is configured in code, not from the environment:
#   createGuard({ facilitatorUrl, facilitatorFallbackUrls: [...] })
# Default is the Base Sepolia testnet facilitator (https://x402.org/facilitator);
# mainnet uses the CDP facilitator.

# ─── RPC (balance checks + anchor commits) ────────────────────────────────────
# Selected by chain: `agentctl audit --verify --chain eip155:8453` uses RPC_BASE,
# eip155:84532 uses RPC_BASE_SEPOLIA. The chain id is asserted against the RPC, so
# a mismatched URL fails loudly instead of silently verifying the wrong network.
RPC_BASE_SEPOLIA=https://sepolia.base.org
RPC_BASE=https://mainnet.base.org

# ─── Audit ────────────────────────────────────────────────────────────────────
# Default SQLite path for the audit store (the store itself is chosen in code via
# `auditStore`: "sqlite", a path, a Postgres connection string, or an AuditStore).
AUDIT_DB_PATH=./agentctl.sqlite
# Deployed AuditAnchor.sol, used by `agentctl audit --verify`
AUDIT_ANCHOR_ADDRESS=0x...
# Key that pays gas for Merkle-root commits (testnet key only). Set anchor.intervalMs in
# code alongside this key to anchor unattended; each tick reconciles then flushes, so a
# reorg or a crash mid-commit cannot leave entries silently un-anchored.
#
# This key is HOT (it signs on every flush) and it is the anchor's whole trust boundary:
# whoever holds it can extend the operator's history. Keep it out of the policy-engine
# process where you can. The contract is immutable, so there is no revocation.
ANCHOR_COMMITTER_KEY=0x...
# Optional: deploy with a separate, cold key. The deployer holds no privileges over the
# anchor (it has no owner), so this only limits the blast radius of the committer key.
ANCHOR_DEPLOYER_KEY=0x...

# ─── Local-dev wallet (raw viem adapter; NEVER use a real key) ────────────────
# Passed in code — `new ViemAdapter({ privateKey: process.env.AGENT_PRIVATE_KEY })`.
AGENT_PRIVATE_KEY=0x...

# ─── HTTP control plane (`agentctl serve`) ────────────────────────────────────
# Bearer token for every route except /health. Pass via --token "$AGENTCTL_TOKEN".
AGENTCTL_TOKEN=

# ─── Rust sidecar (crates/agentctl-engine; standalone, not yet called by the TS engine)
AGENTCTL_ENGINE_HOST=127.0.0.1
AGENTCTL_ENGINE_PORT=8088
AGENTCTL_ENGINE_TOKEN=

# ─── Reference: Base Sepolia USDC ─────────────────────────────────────────────
# USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
